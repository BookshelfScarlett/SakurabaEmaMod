Projectiles.NoaPainterProj.DisplayName: Noa Painter Proj

Configs: {
	ManosabaClientConfig: {
		DisplayName: Client Option

		ParticleDontEmitLight: {
			Label: "[i:Torch]Particles Don't Emit Light"
			Tooltip:
				'''
				Enables to make particles from Mod no longer emit any lights, e.g: particles from vanity set
				Default by false
				'''
		}

		NoFinalBloomPlay: {
			Label: "[i:MusicBox]Don't play Bloom(PV) after Moon Lord fight"
			Tooltip:
				'''
				Enables to not play Bloom(PV) after Moon Lord fight
				Default by false
				'''
		}

		UseCharactorLifeBar: {
			Label: "[i:LifeCrystal]Use Custom Charactor Life Bar"
			Tooltip:
				'''
				Enables to use Custom Charactor Life Bar while equpipping charactor vanity
				Currently has visual bug if mixing with Split, recommend to disable this if you are playing with it
				Default by true
				'''
		}

		TraditionalTooltipShowcase: {
			Label: "[i:Paintbrush]Traditional Sin Tooltip Showcase"
			Tooltip:
				'''
				Enables to use traditional sin tooltip showcase for charactor vanity item
				Default by false
				'''
		}

		NoCustomCharactorSounds: {
			Label: "[i:Megaphone]No Custom Charactor Sounds"
			Tooltip:
				'''
				Enables to stop custom hit sound for charactor vanity item
				Default by false
				'''
		}

		NoCharactorAvatar: {
			Label: "[i:ItemFrame]No Charactor Avatar"
			Tooltip:
				'''
				Enables to stop attempting to draw charactor's avatar to charactor vanity item
				Default by false
				'''
		}

		NoCharactorParticle: {
			Label: "[i:Diamond]No Charactor Particle"
			Tooltip:
				'''
				Enables to stop attempting to spawn particles while equipping charactor vanity item
				Default by false
				'''
		}
	}
}
