SakurabaEmma: {
	DisplayName: 异世贝雷帽
	Tooltip: 对着物品按下中键以切换受击音效
	FlavorTooltip: -受厌恶之人-
	RealTooltip:
		'''
		她是应受厌恶之人
		而比任何人都厌恶她的，正是她本人
		'''
	KiangSound: 当前受击音效：纯享
	RegularSound: 当前受击音效：常规
}

NatsumeAnanItem: {
	DisplayName: 孩童素描本
	Tooltip: ""
	SinnerType: -编织谎言的沉睡公主-
	SinnerTooltip:
		'''
		她今天也独自沉睡着
		因为只要不伤害任何人，那她自己也就不会受伤
		'''
}

NoaPainter: {
	DisplayName: 魔法画笔
	Tooltip:
		'''
		按住挥舞画笔
		在一定时间后，修改自身在死亡之后的效果
		'''
	SinnerType: "[-虚伪的艺术家-]"
	SinnerTooltip: 「所有所有血的红色，都变成蝴蝶的图画吧！」
}

NikaidouHiroItem: {
	DisplayName: 正论之花
	Tooltip: ""
	SinnerType: -正义的执行者-
	SinnerTooltip:
		'''
		她至今走过的路，未曾有一星污点
		在那个名为独善的理想乡中，容不得绞刑台这般异物的存在
		'''
}

JougasakiNoahItem: {
	DisplayName: 伪装矮帽
	Tooltip: 对着物品按下中键以切换死亡音效
	SinnerType: -虚伪的艺术家-
	SinnerTooltip:
		'''
		她在痛苦中不断挣扎着
		可是她却始终没有意识到，束缚着自己的锁链正是自己的尾巴
		'''
	CrySound: 当前死亡音效: 小孩哭哭
	RegularSound: 当前死亡音效：常规
}

TachibanaSherryItem: {
	DisplayName: 小型聚光镜
	Tooltip: ""
	SinnerType: "[-毁灭侦探-]"
	SinnerTooltip:
		'''
		她毁灭了一切
