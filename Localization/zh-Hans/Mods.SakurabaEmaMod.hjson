// Projectiles.NoaPainterProj.DisplayName: Noa Painter Proj

Configs: {
	ManosabaClientConfig: {
		DisplayName: 客户端设置

		ParticleDontEmitLight: {
			Label: "[i:Torch]模组粒子不再发光"
			Tooltip:
				'''
				开启后让模组内的粒子，如人物时装身上散发的粒子不再发光
				默认关闭
				'''
		}

		NoFinalBloomPlay: {
			Label: "[i:MusicBox]击败月球领主后不播放Bloom(PV)"
			Tooltip:
				'''
				开启后在击败月球领主时不再播放Bloom(PV)
				默认关闭
				'''
		}

		UseCharactorLifeBar: {
			Label: "[i:LifeCrystal]使用角色专属的生命条"
			Tooltip:
				'''
				开启后，在佩戴角色时装之后启用模组提供的专属生命条
				目前与裂痕模组存在绘制冲突，如果与裂痕一起游玩推荐关闭这个选项
				默认开启
				'''
		}

		TraditionalTooltipShowcase: {
			Label: "[i:Paintbrush]旧版时装原罪文本绘制方式"
			Tooltip:
				'''
				启用后，角色时装道具的原罪描述将会使用旧版的显示方案
				默认关闭
				'''
		}

		NoCustomCharactorSounds: {
			Label: "[i:Megaphone]禁用角色时装音效"
			Tooltip:
				'''
				启用后，角色时装道具不再修改玩家的受伤音效
				默认关闭
				'''
		}

		NoCharactorAvatar: {
			Label: "[i:ItemFrame]禁用角色时装头像"
			Tooltip:
				'''
				启用后，角色时装道具不再尝试绘制角色的头像
				默认关闭
				'''
		}

		NoCharactorParticle: {
			Label: "[i:Diamond]禁用角色时装粒子特效"
			Tooltip:
				'''
				启用后，角色时装道具不再尝试生成任何粒子特效
				默认关闭
				'''
		}
	}
}
